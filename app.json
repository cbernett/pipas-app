{
  "expo": {
    "name": "App Pipas Labs",
    "slug": "pipas-app-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pipas_icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pipaslabs.app",
      "versionCode": 35,
      "permissions": [
        "android.permission.USB_PERMISSION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#3EECD8",
        "foregroundImage": "./assets/pipas_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "title": "App Pipas Labs"
    },
    "plugins": [
      "./plugins/withUsbSerial"
    ],
    "extra": {
      "eas": {
        "projectId": "2d39e694-01bf-461b-b32a-66b30513c3a1"
      }
    }
  }
}
